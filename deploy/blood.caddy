blood.bladen.me {
    encode zstd gzip

    root * /var/www/blood

    # The relay is a WebSocket pipe: handle_path strips /relay so the service
    # sees the /room/<id> path its client asks for.
    handle_path /relay/* {
        reverse_proxy 127.0.0.1:8902
    }

    # Vite writes content hashes into asset names, so these can be pinned hard.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle /player/assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Character art never changes under a given name and is fetched on demand by
    # the service worker.
    @art path /art/* /player/art/*
    handle @art {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # The shell, the manifest and the service worker decide when a client picks
    # up a new build, so they are never cached.
    @shell path / /index.html /player /player/ /player/index.html /sw.js /player/sw.js /manifest.webmanifest /player/manifest.webmanifest
    handle @shell {
        header Cache-Control "no-store"
        file_server
    }

    handle /player/* {
        try_files {path} {path}/ /player/index.html
        file_server
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}

http://blood.bladen.me {
    redir https://blood.bladen.me{uri} permanent
}
