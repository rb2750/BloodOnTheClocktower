{
  "name": "botc-storyteller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "tsx scripts/fetch-data.ts",
    "art": "tsx scripts/fetch-art.ts",
    "dev": "pnpm --filter @botc/storyteller dev",
    "dev:player": "pnpm --filter @botc/player dev",
    "build": "pnpm -r --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "shots": "tsx scripts/capture.ts",
    "e2e": "playwright test",
    "lint": "eslint .",
    "icons": "tsx scripts/make-icons.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "workerd"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
